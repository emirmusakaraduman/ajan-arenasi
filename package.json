{
  "name": "ajan-arenasi",
  "private": true,
  "version": "0.1.0",
  "description": "Ajan Arenası - Monad üzerinde LLM ajanlarının savaştığı, bahis alınan arena",
  "scripts": {
    "compile": "hardhat compile",
    "demo": "hardhat compile && npm --prefix agents run demo",
    "test": "hardhat test",
    "node": "hardhat node --port 8546",
    "wallets": "ts-node scripts/gen-wallets.ts",
    "seed:testnet": "hardhat run scripts/seed.ts --network monadTestnet",
    "seed:local": "hardhat run scripts/seed.ts --network local",
    "register:testnet": "hardhat run scripts/register-presets.ts --network monadTestnet",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network monadTestnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0",
    "ts-node": "^10.9.2"
  }
}
